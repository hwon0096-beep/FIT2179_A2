{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 450,
    "title": {
        "text": "A World Breathing Unequal Air",
        "subtitle": ["Global PM₂.₅ concentrations expressed as multiples of the annual WHO air quality threshold.", "*Grey countries indicate no available data."],
        "fontSize": 22,
        "subtitleFontSize": 13,
        "dx": 40
    },
    "projection": {
        "type": "equalEarth",
        "scale": 130
    },
    "layer": [
        {
            "data": {
                "url": "https://unpkg.com/world-atlas@2.0.2/countries-110m.json",
                "format": {"type": "topojson", "feature": "countries"}
            },
            "mark": {"type": "geoshape", "fill": "#f0f0f0", "stroke": "white", "strokeWidth": 0.5}
        },
        {
            "data": {"url": "../data/pollution.csv"},
            "transform": [
                {
                    "filter": "datum.Year >= 2016"
                },
                {
                    "calculate": "datum['Country Name'] == 'Russian Federation' ? 'Russia' : datum['Country Name'] == 'Viet Nam' ? 'Vietnam' : datum['Country Name'] == 'Bolivia (Plurinational State of)' ? 'Bolivia' : datum['Country Name'] == 'Iran (Islamic Republic of)' ? 'Iran' : datum['Country Name'] == 'Republic of Korea' ? 'South Korea' : datum['Country Name'] == 'United Republic of Tanzania' ? 'Tanzania' : datum['Country Name'] == 'Venezuela (Bolivarian Republic of)' ? 'Venezuela' : datum['Country Name'] == 'Lao People\\'s Democratic Republic' ? 'Laos' : datum['Country Name']",
                    "as": "standardized_name"
                },
                {
                    "aggregate": [{"op": "mean", "field": "PM2.5 (μg/m3)", "as": "avg_pm25"}],
                    "groupby": ["standardized_name"]
                },
                {
                    "calculate": "datum.avg_pm25 / 5",
                    "as": "pm25_ratio_who"
                },
                {
                    "lookup": "standardized_name",
                    "from": {
                        "data": {
                            "url": "https://unpkg.com/world-atlas@2.0.2/countries-110m.json",
                            "format": {"type": "topojson", "feature": "countries"}
                        },
                        "key": "properties.name"
                    },
                    "as": "geo"
                },
                {"filter": "datum.avg_pm25 != null"}
            ],
            "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
            "encoding": {  
                "shape": {"field": "geo", "type": "geojson"},
                "color": {
                    "field": "pm25_ratio_who",
                    "type": "quantitative",
                    "scale": {
                        "scheme": "yelloworangered",
                        "domain": [0, 2, 5, 10, 20],
                        "clamp": true
                    },
                    "legend": {
                        "title": "Multiple of WHO Guideline",
                        "orient": "right",
                        "offset": 5,
                        "titleAnchor": "start",
                        "gradientLength": 200,
                        "gradientThickness": 15,
                        "titleFontSize": 11,
                        "labelFontSize": 10
                    }
                },
                "tooltip": [
                    {"field": "standardized_name", "type": "nominal", "title": "Country"},
                    {"field": "avg_pm25", "type": "quantitative", "title": "Avg PM₂.₅ (μg/m³)", "format": ".1f"},
                    {"field": "pm25_ratio_who", "type": "quantitative", "title": "Multiple of WHO Guideline", "format": ".1f"}
                ]
            }
        }
    ],
    "config": {"view": {"stroke": null}}
}