{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 450,
    "title": {
        "text": "A World Breathing Unequal Air",
        "subtitle": ["Global PM₂.₅ concentrations expressed as multiples of the annual WHO air quality threshold.", "*Grey countries indicate no available data."],
        "fontSize": 22,
        "subtitleFontSize": 13,
        "dx": 40
    },
    "projection": {
        "type": "equalEarth",
        "scale": 130
    },
    "layer": [
        {
            "data": {
                "url": "https://unpkg.com/world-atlas@2.0.2/countries-110m.json",
                "format": {"type": "topojson", "feature": "countries"}
            },
            "mark": {"type": "geoshape", "fill": "#f0f0f0", "stroke": "white", "strokeWidth": 0.5}
        },
        {
            "data": {"url": "data/pollution.csv"},
            "transform": [
                {
                    "filter": "datum.Year >= 2016"
                },
                {
                    "calculate": "datum['Country Name'] == 'Russian Federation' ? 'Russia' : datum['Country Name'] == 'Viet Nam' ? 'Vietnam' : datum['Country Name'] == 'Bolivia (Plurinational State of)' ? 'Bolivia' : datum['Country Name'] == 'Iran (Islamic Republic of)' ? 'Iran' : datum['Country Name'] == 'Republic of Korea' ? 'South Korea' : datum['Country Name'] == 'United Republic of Tanzania' ? 'Tanzania' : datum['Country Name'] == 'Venezuela (Bolivarian Republic of)' ? 'Venezuela' : datum['Country Name'] == 'Lao People\\'s Democratic Republic' ? 'Laos' : datum['Country Name']",
                    "as": "standardized_name"
                },
                {
                    "aggregate": [{"op": "mean", "field": "PM2.5 (μg/m3)", "as": "avg_pm25"}],
                    "groupby": ["standardized_name"]
                },
                {
                    "calculate": "datum.avg_pm25 / 5",
                    "as": "pm25_ratio_who"
                },
                {
                    "lookup": "standardized_name",
                    "from": {
                        "data": {
                            "url": "https://unpkg.com/world-atlas@2.0.2/countries-110m.json",
                            "format": {"type": "topojson", "feature": "countries"}
                        },
                        "key": "properties.name"
                    },
                    "as": "geo"
                },
                {"filter": "datum.avg_pm25 != null"}
            ],
            "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
            "encoding": {  
                "shape": {"field": "geo", "type": "geojson"},
                "color": {
                    "field": "pm25_ratio_who",
                    "type": "quantitative",
                    "scale": {
                        "type": "threshold", 
                        "domain": [2, 5, 10, 20], 
                        "range": ["#fef0d9", "#fdcc8a", "#fc8d59", "#e34a33", "#b30000"] 
                    },
                    "legend": {
                        "title": "WHO Guideline Multiple",
                        "orient": "right",
                        "titleAnchor": "start",
                        "labelExpr": "datum.value == 2 ? '0 - 2x' : datum.value == 5 ? '2 - 5x' : datum.value == 10 ? '5 - 10x' : datum.value == 20 ? '10 - 20x' : '> 20x'"
                    }
                },
                "tooltip": [
                    {"field": "standardized_name", "type": "nominal", "title": "Country"},
                    {"field": "avg_pm25", "type": "quantitative", "title": "Avg PM₂.₅ (μg/m³)", "format": ".1f"},
                    {"field": "pm25_ratio_who", "type": "quantitative", "title": "Multiple of WHO Guideline", "format": ".1f"}
                ]
            }
        },
        {
            "data": {
                "values": [
                    {
                        "start_lon": 67.7, "start_lat": 33.9, 
                        "end_lon": -5.0, "end_lat": 35.0
                    },
                    {
                        "start_lon": 101.97, "start_lat": 4.21, 
                        "end_lon": 90.0, "end_lat": -35.0
                    }
                ]
            },
            "mark": {
                "type": "rule",
                "color": "#444444",
                "strokeWidth": 1,
                "strokeDash": [2, 2]
            },
            "encoding": {
                "longitude": {"field": "start_lon", "type": "quantitative"},
                "latitude": {"field": "start_lat", "type": "quantitative"},
                "longitude2": {"field": "end_lon"},
                "latitude2": {"field": "end_lat"}
            }
        },
        {
            "data": {
                "values": [
                    {
                        "longitude": -40.0, 
                        "latitude": 40.0, 
                        "text": ["Afghanistan drastically","exceeds global", "health thresholds."],
                        "align": "center"
                    },
                    {
                        "longitude": 80.0, 
                        "latitude": -40.0, 
                        "text": ["Malaysia breaches guidelines,", "avoiding global extremes."],
                        "align": "center"
                    }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 10.5,
                "fontWeight": "bold",
                "color": "#1a252f",
                "lineHeight": 13
            },
            "encoding": {
                "longitude": {"field": "longitude", "type": "quantitative"},
                "latitude": {"field": "latitude", "type": "quantitative"},
                "text": {"field": "text", "type": "nominal"},
                "align": {"field": "align", "type": "nominal", "scale": null}
            }
        }
    ],
    "config": {"view": {"stroke": null}}
}