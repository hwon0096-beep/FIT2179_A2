{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "LULUCF Reduces Malaysia’s Net Emissions (2019)",
        "subtitle": "Natural carbon sinks significantly reduce the total impact of industrial and energy sectors.",
        "fontSize": 22,
         "subtitleFontSize": 13
    },
    "width": "container",
    "height": 400,
    "data": {
        "url": "data/ghg_emissions.csv",
        "format": {"parse": {"date": "date:'%Y-%m-%d'"}}
    },
    "transform": [
        {"filter": "year(datum.date) == 2019"},
        {"filter": "indexof(['energy', 'industrial_processes', 'agriculture', 'waste', 'lulucf', 'net'], datum.source) >= 0"},
        {
            "calculate": "indexof(['energy', 'industrial_processes', 'agriculture', 'waste', 'lulucf', 'net'], datum.source)",
            "as": "order"
        },
        {
            "sort": [{"field": "order"}],
            "window": [{"op": "sum", "field": "emissions", "as": "cumulative_emissions"}]
        },
        {
            "calculate": "datum.source == 'net' ? 0 : datum.cumulative_emissions - datum.emissions",
            "as": "start_val"
        },
        {
            "calculate": "datum.source == 'net' ? datum.emissions : datum.cumulative_emissions",
            "as": "end_val"
        }
    ],
    "layer": [
        {
            "name": "WaterFallBars",
            "mark": "bar",
            "encoding": {
                "x": {
                    "field": "source",
                    "type": "nominal",
                    "sort": {"field": "order"},
                    "axis": {
                        "labelAngle": 0,
                        "title": "Emission Source",
                        "labelFontSize": 12,
                        "titleFontSize": 14,
                        "labelPadding": 10
                    }
                },
                "y": {
                    "field": "start_val",
                    "type": "quantitative",
                    "title": "Emissions (kt CO₂e)",
                    "axis": {"titleFontSize": 14}
                },
                "y2": {
                    "field": "end_val"
                },
                "color": {
                    "field": "source",
                    "type": "nominal",
                    "scale": {"domain": ["energy","industrial_processes", "agriculture", "waste", "lulucf", "net"], "range": ["#2171b5","#084594", "#6baed6", "#bdd7e7", "#22A884FF", "#FDE725FF"]},
                    "legend": null
                }
            }
         },
         {
        "name": "LULUCF_Annotation",
        "data": {
            "values": [{
            "source": "agriculture", 
            "y": 100000, 
            "text": ["LULUCF acts as a carbon sink,", "absorbing CO₂ to offset gross emissions."]
            }]
        },
        "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 11,
            "fontStyle": "italic",
            "lineHeight": 13,
            "color": "#22A884FF"
        },
        "encoding": {
            "x": {"field": "source", "type": "nominal", "sort": {"field": "order"}},
            "y": {"field": "y", "type": "quantitative"},
            "text": {"field": "text"}
        }
        }
    ],
    "config": {
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}