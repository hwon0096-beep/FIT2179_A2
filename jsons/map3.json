{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": {
    "text": "Widespread Air Quality Failure Across Both Urban and Rural Malaysia",
    "subtitle": "Industrial regional centers heavily outpace Malaysia's national air pollution baseline.",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "projection": {
    "type": "mercator",
    "center": [109.0, 4.2],
    "scale": 2200
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "#cccccc",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/codeforamerica/click_that_hood/master/public/data/malaysia.geojson",
        "format": {
          "type": "geojson"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f9f9f9",
        "stroke": "#444444",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/pollution.csv"
      },
      "transform": [
        {
          "filter": "datum['Country Name'] == 'Malaysia'"
        },
        {
          "calculate": "datum['PM2.5 (μg/m3)']",
          "as": "pm_val"
        },
        {
          "calculate": "datum.City == 'Johor' ? 'Johor Bahru' : datum.City == 'Kedah' ? 'Alor Setar' : datum.City == 'Kelantan' ? 'Kota Bharu' : datum.City == 'Negeri Sembilan' ? 'Seremban' : datum.City == 'Perak' ? 'Ipoh' : datum.City == 'Perlis' ? 'Kangar' : datum.City == 'Pulau Pinang' ? 'George Town' : datum.City == 'Sabah' ? 'Kota Kinabalu' : datum.City == 'Sarawak' ? 'Kuching' : datum.City == 'Selangor' ? 'Shah Alam' : datum.City == 'Terengganu' ? 'Kuala Terengganu' : datum.City == 'W.p Labuan' ? 'Labuan' : datum.City",
          "as": "NormalizedCity"
        },
        {
          "filter": "datum.pm_val > 0"
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "pm_val",
              "as": "avg_pm25"
            }
          ],
          "groupby": ["NormalizedCity"]
        },
        {
          "calculate": "datum.avg_pm25 > 21.1 ? 'Above Malaysia Average' : 'Below Malaysia Average'",
          "as": "SafetyStatus"
        },
        {
          "lookup": "NormalizedCity",
          "from": {
            "data": {
              "url": "data/my.csv"
            },
            "key": "city",
            "fields": ["lat", "lng"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.6,
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "avg_pm25",
          "type": "quantitative",
          "title": "Average PM₂.₅(μg/m³)",
          "scale": {
            "type": "quantile",
            "range": [100, 450, 900, 1500, 2200]
          }
        },
        "color": {
          "field": "SafetyStatus",
          "type": "nominal",
          "title": "Safety Status",
          "scale": {
            "domain": [
              "Above Malaysia Average",
              "Below Malaysia Average"
            ],
            "range": ["#D95F02", "#4A4A4A"]
          }
        },
        "tooltip": [
          {
            "field": "NormalizedCity", 
            "type": "nominal", 
            "title": "State/City"
          },
          {
            "field": "avg_pm25", 
            "type": "quantitative", 
            "title": "Avg PM₂.₅ (μg/m³)", 
            "format": ".1f"
          },
          {
            "field": "SafetyStatus", 
            "type": "nominal", 
            "title": "Benchmark Status"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "Johor", "lat": 0.9, "lng": 104.0},
          {"state": "Selangor", "lat": 3.3, "lng": 101.0},
          {"state": "Kedah", "lat": 6.1, "lng": 99.9},
          {"state": "Penang", "lat": 5.4, "lng": 100.0},
          {"state": "Perak", "lat": 4.9, "lng": 101.8},
          {"state": "Kelantan", "lat": 6.6, "lng": 102.2},
          {"state": "Terengganu", "lat": 5.6, "lng": 103.1},
          {"state": "Negeri Sembilan", "lat": 2.7, "lng": 102.3},
          {"state": "Pahang", "lat": 3.8, "lng": 102.4},
          {"state": "Sabah", "lat": 5.5, "lng": 116.0},
          {"state": "Sarawak", "lat": 1.5, "lng": 111.0},
          {"state": "Melaka", "lat": 2.0, "lng": 102.7},
          {"state": "Perlis", "lat": 6.6, "lng": 100.2}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "fill": "#222"
      },
      "encoding": {
        "longitude": {"field": "lng", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "state"}
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": 4.1,
            "lng": 103.0,
            "text": [
              "West coast industrial centers report",
              "the highest pollution concentrations."
            ]
          },
          {
            "lat": 7.0,
            "lng": 110.3,
            "text": [
              "Sabah managed to maintain",
              "the lowest pollution concentrations"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 45,
        "dy": -25,
        "fontSize": 12,
        "fontStyle": "italic",
        "fill": "#444",
        "lineHeight": 12
      },
      "encoding": {
        "longitude": {"field": "lng"},
        "latitude": {"field": "lat"},
        "text": {"field": "text"}
      }
    },
    {
      "data": {
        "values": [
          {"lat": 3.0, "lng": 101.5, "lat_end": 4.0, "lng_end": 105.0},
          {"lat": 5.975, "lng": 116.0, "lat_end": 7.0, "lng_end": 114.3},
          {"lat": 5.3, "lng": 115.22, "lat_end": 7.0, "lng_end": 114.3}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "black",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "lng"},
        "latitude": {"field": "lat"},
        "longitude2": {"field": "lng_end"},
        "latitude2": {"field": "lat_end"}
      }
    }
  ],
  "config": {
    "title": {"fontSize": 16},
    "legend": {"orient": "right", "offset": 10}
  }
}